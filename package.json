{
  "name": "babel-art",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A physical-space generative art wall simulator with per-display timing experiments.",
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 4173",
    "test": "node --import tsx --test tests/*.test.js",
    "test:browser": "node scripts/browser-check.mjs",
    "build:pages": "vite build --base=/babel-art/",
    "typecheck": "tsc --noEmit",
    "test:chemical": "node scripts/check-chemical.mjs",
    "test:evolution": "node scripts/check-evolution.mjs",
    "test:visuals": "node scripts/check-visuals.mjs",
    "build:soak": "vite build --mode soak --base=/ --outDir artifacts/soak-site",
    "test:soak": "npm run build:soak && node scripts/soak.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.6"
  }
}
